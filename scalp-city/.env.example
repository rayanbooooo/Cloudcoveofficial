# ─────────────────────────────────────────────────────────────────────────────
# SCALP CITY — environment configuration
#
# Copy to `.env` and fill in. NEVER commit `.env`. NEVER put real credentials
# in this file. Secrets are only ever read by the server process; nothing in
# this file is shipped to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Which broker trades. One broker per server; every order, position and limit
# is kept per broker, so switching never mixes the two books.
#   alpaca  US stocks and options (QQQ, SPY, IWM …)            — see the ALPACA_* block
#   oanda   gold, Nasdaq 100, FX and index CFDs                 — see the OANDA_* block
# Alpaca cannot trade FX, metals or index CFDs; that is what OANDA is for.
BROKER=alpaca

# paper | live. Defaults to paper. Live requires BOTH this AND
# LIVE_TRADING_ENABLED=true AND an in-app confirmation before any real order.
# With BROKER=oanda, "paper" is an OANDA fxTrade PRACTICE account and "live" is fxTrade.
TRADING_ENVIRONMENT=paper

# ─── OANDA (BROKER=oanda) ────────────────────────────────────────────────────
# Personal access token + account id from your OANDA account (Manage API
# Access). A PRACTICE token only works against OANDA's practice servers and a LIVE
# token only against fxTrade; the app picks the endpoint from TRADING_ENVIRONMENT
# and the LIVE host is pinned (the server refuses to start live against any other).
# NEVER paste a token into chat, git or a screenshot: it goes in the host's
# environment settings only.
OANDA_PRACTICE_TOKEN=
OANDA_PRACTICE_ACCOUNT_ID=
OANDA_LIVE_TOKEN=
OANDA_LIVE_ACCOUNT_ID=
# Instruments the workers trade (OANDA names). Default: gold, Nasdaq 100, GBP/USD, EUR/JPY, US30.
# Metals and index CFDs are not offered to every account (it depends on your OANDA
# entity / region): the app reads your account's instrument list and shows
# "not offered to this account" instead of trading anything it cannot.
OANDA_INSTRUMENTS=XAU_USD,NAS100_USD,GBP_USD,EUR_JPY,US30_USD
# The window workers may open NEW positions in, New York time. OANDA markets run
# nearly 24h, so this is a choice, not an exchange schedule. Weekdays only.
OANDA_SESSION=09:30-16:00
OANDA_SKIP_US_HOLIDAYS=true
# Risk limits for OANDA (account currency). These seed the risk settings on first
# boot; afterwards they are managed in-app. Alpaca's MAX_* values below do NOT apply
# to OANDA — they are share/option sized and would block every CFD order.
OANDA_MAX_DAILY_LOSS=100
# The most one order may lose if its broker-held stop is hit.
OANDA_MAX_RISK_PER_TRADE=20
# Open exposure per instrument and per order: units × price in account currency.
OANDA_MAX_POSITION_NOTIONAL=10000
# OANDA_MAX_ORDER_NOTIONAL=10000
OANDA_MAX_CONCURRENT_POSITIONS=3
OANDA_MAX_TRADES_PER_DAY=10

# ─── ALPACA (BROKER=alpaca) ──────────────────────────────────────────────────
# Credentials for the environment selected above (Alpaca Trading API keys for
# a personal account — NOT Broker API keys).
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional: separate credentials per environment. When set, they take
# precedence over ALPACA_API_KEY/SECRET for that environment and allow
# switching PAPER <-> LIVE from the app (switching to LIVE requires
# re-authentication and explicit confirmation).
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# Endpoints. The LIVE trading URL is pinned: the server refuses to start a
# live context against anything other than https://api.alpaca.markets.
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets

# Market data feeds — set these to what your Alpaca data plan actually
# includes. The UI labels data honestly based on these values.
#   iex          real-time, IEX exchange only (free plan; partial volume)
#   sip          real-time consolidated tape (paid plan)
#   delayed_sip  15-minute delayed — displayed as DELAYED, trading blocked
ALPACA_STOCK_FEED=iex
#   indicative   free, NOT the real NBBO — automated options trading is blocked
#   opra         real-time OPRA (paid plan)
ALPACA_OPTIONS_FEED=indicative
# Paper only: allow workers to trade options against the indicative feed so
# the full pipeline can be exercised without an OPRA subscription. Ignored
# (always false) in live.
PAPER_ALLOW_INDICATIVE_OPTIONS=false

# PostgreSQL connection string, e.g. postgres://scalp:scalp@localhost:5432/scalp_city
DATABASE_URL=

# Random string, at least 32 characters. Used to sign session/CSRF tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Server-side live trading lock. Defaults to false. While false, the server
# refuses every live order regardless of anything the UI does.
LIVE_TRADING_ENABLED=false

# Global risk limits for ALPACA (USD unless noted). These seed the risk settings
# on first boot; afterwards they are managed in-app (increases require
# confirmation and are audit-logged). For OANDA use the OANDA_MAX_* block above.
MAX_DAILY_LOSS=500
# Max notional value of any single position (MAX_POSITION_NOTIONAL alias accepted)
MAX_POSITION_SIZE=1000
MAX_ORDER_NOTIONAL=1000
MAX_CONTRACTS=20
MAX_SHARES=100
MAX_CONCURRENT_POSITIONS=3
MAX_TRADES_PER_DAY=10
MAX_ORDERS_PER_MINUTE=10

# Safety thresholds
MAX_DATA_AGE_MS=5000
MAX_OPTION_QUOTE_AGE_MS=10000
MAX_CLOCK_SKEW_MS=2000

# Symbols the market data service subscribes to (Alpaca; workers use a subset).
# For OANDA the symbols come from OANDA_INSTRUMENTS.
SYMBOLS=QQQ,SPY,IWM

# HTTP server
HOST=127.0.0.1
PORT=8787
# Origins allowed to open the real-time WebSocket (comma separated).
# Defaults to the Vite dev server origins when unset.
ALLOWED_ORIGINS=
# Secure cookies require HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=
LOG_LEVEL=info
