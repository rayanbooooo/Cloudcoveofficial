# ─────────────────────────────────────────────────────────────────────────────
# SCALP CITY — environment configuration
#
# Copy to `.env` and fill in. NEVER commit `.env`. NEVER put real credentials
# in this file. Secrets are only ever read by the server process; nothing in
# this file is shipped to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# paper | live. Defaults to paper. Live requires BOTH this AND
# LIVE_TRADING_ENABLED=true AND an in-app confirmation before any real order.
TRADING_ENVIRONMENT=paper

# Credentials for the environment selected above (Alpaca Trading API keys for
# a personal account — NOT Broker API keys).
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional: separate credentials per environment. When set, they take
# precedence over ALPACA_API_KEY/SECRET for that environment and allow
# switching PAPER <-> LIVE from the app (switching to LIVE requires
# re-authentication and explicit confirmation).
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

# Endpoints. The LIVE trading URL is pinned: the server refuses to start a
# live context against anything other than https://api.alpaca.markets.
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets

# Market data feeds — set these to what your Alpaca data plan actually
# includes. The UI labels data honestly based on these values.
#   iex          real-time, IEX exchange only (free plan; partial volume)
#   sip          real-time consolidated tape (paid plan)
#   delayed_sip  15-minute delayed — displayed as DELAYED, trading blocked
ALPACA_STOCK_FEED=iex
#   indicative   free, NOT the real NBBO — automated options trading is blocked
#   opra         real-time OPRA (paid plan)
ALPACA_OPTIONS_FEED=indicative
# Paper only: allow workers to trade options against the indicative feed so
# the full pipeline can be exercised without an OPRA subscription. Ignored
# (always false) in live.
PAPER_ALLOW_INDICATIVE_OPTIONS=false

# PostgreSQL connection string, e.g. postgres://scalp:scalp@localhost:5432/scalp_city
DATABASE_URL=

# Random string, at least 32 characters. Used to sign session/CSRF tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Server-side live trading lock. Defaults to false. While false, the server
# refuses every live order regardless of anything the UI does.
LIVE_TRADING_ENABLED=false

# Global risk limits (USD unless noted). These seed the risk settings on
# first boot; afterwards they are managed in-app (increases require
# confirmation and are audit-logged).
MAX_DAILY_LOSS=500
# Max notional value of any single position (MAX_POSITION_NOTIONAL alias accepted)
MAX_POSITION_SIZE=1000
MAX_ORDER_NOTIONAL=1000
MAX_CONTRACTS=20
MAX_SHARES=100
MAX_CONCURRENT_POSITIONS=3
MAX_TRADES_PER_DAY=10
MAX_ORDERS_PER_MINUTE=10

# Safety thresholds
MAX_DATA_AGE_MS=5000
MAX_OPTION_QUOTE_AGE_MS=10000
MAX_CLOCK_SKEW_MS=2000

# Symbols the market data service subscribes to (workers use a subset)
SYMBOLS=QQQ,SPY,IWM

# HTTP server
HOST=127.0.0.1
PORT=8787
# Origins allowed to open the real-time WebSocket (comma separated).
# Defaults to the Vite dev server origins when unset.
ALLOWED_ORIGINS=
# Secure cookies require HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=
LOG_LEVEL=info
